[application]
config/name="Ejercicio 3 - Media de notas"
run/main_scene="res://media.tscn"

[display]
window/size/viewport_width=700
window/size/viewport_height=500
window/size/window_width_override=700
window/size/window_height_override=500

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
