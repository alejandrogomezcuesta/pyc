[application]
config/name="Ejercicio 4 - Kilometros a metros"
run/main_scene="res://distancia.tscn"

[display]
window/size/viewport_width=700
window/size/viewport_height=350
window/size/window_width_override=700
window/size/window_height_override=350

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
